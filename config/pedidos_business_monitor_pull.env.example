PEDIDOS_REMOTE_HOST=servidor-pleno
PEDIDOS_REMOTE_USER=usuario_monitor
PEDIDOS_REMOTE_PORT=22
PEDIDOS_REMOTE_COMMAND=/servpleno/monitor/pedidos_monitor_json.sh

# Recomendado: chave SSH montada no container/host.
PEDIDOS_SSH_KEY=/app/config/ssh/id_monitor_pleno

# Alternativa temporaria: senha via sshpass.
# PEDIDOS_SSH_PASSWORD=senha

PEDIDOS_SSH_STRICT_HOST_KEY_CHECKING=accept-new
PEDIDOS_SSH_TIMEOUT_SECONDS=60
PEDIDOS_MONITOR_STATUS_FILE=/app/outputs/pleno_business_monitor/pedidos.json
