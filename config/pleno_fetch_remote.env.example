# Copie para config/pleno_fetch_remote.env e ajuste os dois servidores.

# Compatibilidade com a configuracao antiga. Se os blocos abaixo nao forem
# preenchidos, estes valores serao usados como padrao.
REMOTE_USER=root
REMOTE_HOST=BRHDCVLNX027
REMOTE_PORT=22
REMOTE_PASSWORD=""

# Servidor onde ficam os pacotes .tar.gz gerados pela auditoria/snapshot
# de movimentos do Pleno.
PACKAGE_REMOTE_USER=root
PACKAGE_REMOTE_HOST=BRHDCVLNX027
PACKAGE_REMOTE_PORT=22
PACKAGE_REMOTE_PASSWORD=""
PACKAGE_REMOTE_DIRS="/dev/audit_lojas/outputs/pleno_stock_audit_packages /dev/audit_lojas/outputs/pleno_stock_snapshot_packages"

# Servidor onde ficam os CSVs oficiais de estoque, no padrao estoque_YYYYMMDD*.csv.
STOCK_REMOTE_USER=amc018br
STOCK_REMOTE_HOST=172.22.20.101
STOCK_REMOTE_PORT=22
STOCK_REMOTE_PASSWORD=""
STOCK_CURRENT_DIR="/servpleno/exportacao"
STOCK_PREVIOUS_DIR="/servpleno/exportacao/processados"
STOCK_REMOTE_DIRS="/servpleno/exportacao /servpleno/exportacao/processados"

# Monitores operacionais extras. Se nao forem preenchidos, usam o mesmo acesso
# STOCK_REMOTE_* acima.
DEVOLUCAO_AS400_REMOTE_BASE="/servpleno/exportacao/enviados_devolucao"
DEVOLUCAO_AS400_TARGET_TIME="17:45"
MERCADORIA_FILIAL_REMOTE_DIR="/servpleno/importacao"
MERCADORIA_FILIAL_RECEIVED_TARGET_TIME="08:30"
MERCADORIA_FILIAL_CONSUMED_TARGET_TIME="09:30"

# Pasta local de entrada monitorada pela aplicacao web.
LOCAL_INBOX="outputs/recebidos_servidor"
