MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=seu_usuario
MYSQL_PASSWORD=sua_senha
MYSQL_DATABASE=pleno
MYSQL_CONNECTION_LIMIT=10

# Opcional: ajuste a consulta inicial
CONEX_TABLE=conex
CONEX_LIMIT=20

# WhatsApp via Z-API
WHATSAPP_ZAPI_PORT=3097
WHATSAPP_ZAPI_PUBLIC_BASE_URL=https://sua-url-publica
WHATSAPP_ZAPI_WEBHOOK_SECRET=troque-este-segredo
WHATSAPP_AUTO_REPLY=false
WHATSAPP_DRY_RUN=true
WHATSAPP_ALLOW_GROUPS=false
WHATSAPP_BUSINESS_NAME=Equipe
WHATSAPP_SYSTEM_PROMPT=Voce atende clientes pelo WhatsApp em portugues do Brasil. Seja claro, educado e breve.
WHATSAPP_ZAPI_LOG_FILE=outputs/whatsapp-zapi-events.jsonl

ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io

# Opcional: se preenchido, gera respostas com IA. Sem isso, usa resposta padrao simples.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# WhatsApp Web via Playwright
WHATSAPP_WEB_HOST=127.0.0.1
WHATSAPP_WEB_PORT=3108
WHATSAPP_WEB_DB_FILE=outputs/whatsapp-web/messages.db
WHATSAPP_WEB_USER_DATA_DIR=outputs/whatsapp-web/chrome-profile
WHATSAPP_WEB_HEADLESS=false
WHATSAPP_WEB_AUTO_START_WATCHER=false
WHATSAPP_WEB_SCAN_INTERVAL_MS=15000
WHATSAPP_WEB_MAX_CHATS_PER_SCAN=25
WHATSAPP_WEB_MAX_MESSAGES_PER_CHAT=20
