FROM node:22-alpine

ENV TZ=America/Sao_Paulo \
    AUDIT_WEB_HOST=0.0.0.0 \
    AUDIT_WEB_PORT=8094 \
    OMNILOJA_APP_NAME=omniloja

RUN apk add --no-cache tini tar tzdata openssh-client sshpass bash expect perl python3 py3-pymysql

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY audit-web ./audit-web
COPY scripts ./scripts
COPY config ./config

RUN mv /usr/local/bin/node /usr/local/bin/node-real \
    && cp /app/scripts/node-init.sh /usr/local/bin/node \
    && chmod 755 /usr/local/bin/node \
    && mkdir -p /app/outputs/recebidos_servidor \
      /app/outputs/pleno_stock_audit \
      /app/outputs/pleno_stock_snapshots \
      /app/outputs/pleno_stock_audit_excel \
      /app/outputs/pleno_stock_official \
      /app/outputs/pleno_stock_official_index \
      /app/outputs/pleno_cron_monitor \
      /app/outputs/pleno_business_monitor \
      /app/outputs/tesouraria_cofre_inteligente \
      /app/outputs/prevencao_perdas

EXPOSE 8094

ENTRYPOINT ["tini", "--"]
CMD ["node", "audit-web/server.mjs"]
