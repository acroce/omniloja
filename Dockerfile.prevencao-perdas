FROM mcr.microsoft.com/playwright:v1.62.1-jammy

ENV TZ=America/Sao_Paulo \
    DEBIAN_FRONTEND=noninteractive \
    AUDIT_WEB_HOST=0.0.0.0 \
    AUDIT_WEB_PORT=8096 \
    PREV_PERDAS_ROOT=/app \
    PREV_PERDAS_LOCK_FILE=/app/outputs/prevencao_perdas/prevencao-perdas.lock \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && apt-get install -y --no-install-recommends \
      cron util-linux tzdata ca-certificates python3 xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY audit-web ./audit-web
COPY scripts ./scripts
COPY docker/prevencao-perdas-entrypoint.sh /usr/local/bin/prevencao-perdas-entrypoint

RUN chmod +x /usr/local/bin/prevencao-perdas-entrypoint /app/scripts/run-prevencao-perdas-cron.sh \
    && mkdir -p /app/outputs/prevencao_perdas /app/.cache

EXPOSE 8096
ENTRYPOINT ["/usr/local/bin/prevencao-perdas-entrypoint"]
